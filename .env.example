# Database (required)
DATABASE_URL=postgresql+asyncpg://finagent:password@localhost:5434/finagent
MIGRATION_DATABASE_URL=postgresql+psycopg://finagent:password@localhost:5434/finagent
REDIS_URL=redis://localhost:6379/0

# FastAPI
SECRET_KEY=change-me
